#!/usr/bin/env bash
# The hard gate (C-17, RUN-002). Enabled by `make init` (core.hooksPath = .githooks).
# Cheap checks first, so a push fails fast with the real reason:
#   1. no push to main unless ALLOW_MAIN_PUSH=1 (bootstrap only, RUN-002.D5);
#   2. .env exists (a worktree needs `make init`, RUN-002.D3);
#   3. a task branch (<sys>-<nnn>... or agent-office's office/*) names its acceptance test
#      in .task (RUN-002.D4, D9);
# then the slow ones:
#   4. the default tiers pass (unit + db + integration);
#   5. the gpu tier passes when classifier/models/ or prompts/ changed;
#   6. the acceptance test passes.
# Never bypass it with --no-verify (CLAUDE.md "Hard rules").
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"
. .claude/hooks/common.sh

fail() { printf 'pre-push BLOCKED: %s\n' "$*" >&2; exit 1; }

only_deletes=1
while read -r _local_ref local_sha remote_ref _remote_sha; do
  if [ "$remote_ref" = "refs/heads/main" ] && [ "${ALLOW_MAIN_PUSH:-0}" != "1" ]; then
    fail "direct pushes to main are not allowed; open a PR (main changes only through gh pr merge)"
  fi
  [[ "$local_sha" =~ ^0+$ ]] || only_deletes=0
done
# RUN-002.D15: deleting a remote branch publishes no code, so it needs no test run.
if [ "$only_deletes" = 1 ]; then echo "pre-push: branch deletion only, nothing to test"; exit 0; fi

[ -f .env ] || fail "no .env in $(basename "$PWD"); run 'make init' here first (it copies .env from the main checkout)"

branch="$(git branch --show-current)"
acc=""
if [[ "$branch" =~ ^[a-z]+-[0-9]{3} || "$branch" == office/* ]]; then
  acc="$(task_field acceptance)"
  [ -n "$acc" ] || fail "task branch '$branch' has no acceptance=... line in .task (CLAUDE.md section 2.2)"
fi

echo "pre-push: default tiers (unit + db + integration)"
compose_test pytest -q || fail "default test tiers failed"

base="$(git merge-base HEAD origin/main 2>/dev/null || true)"
if [ -n "$base" ] && git diff --name-only "$base" HEAD | grep -qE '^(classifier/models/|prompts/)'; then
  echo "pre-push: gpu tier (models/ or prompts/ changed)"
  compose_test pytest -q -m gpu || fail "gpu tier failed"
fi

if [ -n "$acc" ]; then
  echo "pre-push: acceptance test $acc"
  case "$acc" in
    scripts/gate_*.py) compose_test python "$acc" || fail "acceptance gate $acc failed" ;;
    *) compose_test pytest -q -m "unit or db or integration or gpu or gate" "$acc" || fail "acceptance test $acc failed" ;;
  esac
fi
echo "pre-push: all gates passed"
