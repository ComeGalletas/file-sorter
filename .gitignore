# Secrets and local config (public repo)
.env
sanitize.yaml
# The human's private prompt addenda (RUN-017.D1, CLS-004.6); only the examples are committed
prompts/local/*.md
!prompts/local/*.example.md
# Image data never leaves the box
fixtures/images/
fixtures/labels.csv
# RUN-018.D1: no image file is committed anywhere, so a stray copy can't be pushed by mistake
*.[pP][nN][gG]
*.[jJ][pP][gG]
*.[jJ][pP][eE][gG]
*.[gG][iI][fF]
*.[wW][eE][bB][pP]
*.[hH][eE][iI][cC]
*.[hH][eE][iI][fF]
*.[bB][mM][pP]
*.[tT][iI][fF]
*.[tT][iI][fF][fF]
# Runtime artifacts
.work/
reports/
# Python
__pycache__/
*.pyc
.venv/
.pytest_cache/
.ruff_cache/
*.egg-info/
build/
dist/
# RUN-018.D1: scratch files at the repo root (commit-message drafts, logs)
/*.txt
/*.log
# agent-office data for this floor: worker worktrees, office password, state (RUN-003)
.agent-office/

# Claude Code: per-machine settings and the per-worktree task file (RUN-002.D4)
.claude/settings.local.json
.task
