{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "defaultMode": "acceptEdits",
    "deny": [
      "Bash(gh pr merge*)",
      "Bash(git merge*)",
      "Bash(git push origin main*)",
      "Bash(git push * main*)",
      "Bash(git tag*)",
      "Edit(./docs/journals/INDEX.md)",
      "Edit(./docs/plans/**)",
      "Edit(./DESIGN.md)",
      "Edit(./CLAUDE.md)"
    ]
  }
}
