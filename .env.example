# Copy to .env with `make init`. .env is git-ignored: never commit it.
# Windows host paths for Docker Desktop bind mounts: forward slashes, quoted (spaces are fine).

# Your image folder. Mounted READ-ONLY at /source; never modified.
SOURCE_ROOT="D:/path/to/your/images"

# Where sorted copies go. Mounted at /results. Must not be inside SOURCE_ROOT (R-FOP-9).
RESULTS_ROOT="D:/path/to/sorted"

# Per-agent logs, outside the repo (CLAUDE.md §2.2). Relative to the repo's main checkout.
AGENT_LOG_ROOT="../agent-logs"

# DB_PASSWORD and SEARXNG_SECRET are generated and appended by `make init`.
